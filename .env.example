# =====================================================================
# Chauffage Artisanal — Variables d'environnement
# Renommez en .env.local et remplissez selon votre déploiement.
# =====================================================================

# URL publique du site (pour les liens dans les emails)
PUBLIC_URL=http://localhost:3008

# ─────────────────────── EMAIL (Resend) ───────────────────────
# Si non défini, les emails sont loggés en console (dev mode).
# 1. Créez un compte sur https://resend.com
# 2. Vérifiez votre domaine (chauffage-artisanal.lu)
# 3. Générez une clé API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=devis@chauffage-artisanal.lu
EMAIL_ADMIN=contact@chauffage-artisanal.lu

# ─────────────────────── BASE DE DONNÉES (Supabase) ───────────────────
# Si non défini, les leads sont stockés dans /data/leads.json (dev mode).
# 1. Créez un projet sur https://supabase.com
# 2. Créez une table `leads` (cf. README-pipeline.md)
# 3. Créez un bucket storage `leads-photos`
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────── ADMIN ────────────────────────────────────────
# Token pour protéger /admin/* (à compléter quand auth implémentée)
ADMIN_TOKEN=change-me-in-prod

# ─────────────────────── ANTI-SPAM (optionnel) ────────────────────────
# Pour scaler le rate-limit sur multi-instance (Vercel edge multi-région)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
